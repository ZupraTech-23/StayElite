<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employee List</title>
  <link rel="stylesheet" href="/public/style/employtable.css">
</head>
<body>
  <div class="container">
    <h1>Employee List</h1>

    <!-- Search Bar -->
    <form action="/employees" method="get" class="search-bar">
      <input 
        type="text" 
        name="search" 
        placeholder="Search by employee name..." 
        value="<%= typeof search !== 'undefined' ? search : '' %>">
      <button type="submit">Search</button>
    </form>

    <!-- Employee Table -->
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Employee Name</th>
          <th>Role</th>
          <th>Phone No.</th>
          <th>Aadhaar No.</th>
        </tr>
      </thead>
      <tbody>
        <% if (employees.length > 0) { %>
          <% employees.forEach((emp, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= emp.name %></td>
              <td><%= emp.role %></td>
              <td><%= emp.phone %></td>
              <td><%= emp.aadhaar %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5">No employees found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
