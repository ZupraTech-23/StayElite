<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employee Attendance</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      min-height: 100vh;
    }

    .container {
      background: #fff;
      margin-top: 40px;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      width: 95%;
      max-width: 1100px;
    }

    h1 {
      text-align: center;
      color: #333;
      margin-bottom: 25px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }

    table th, table td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: center;
    }

    table th {
      background: #667eea;
      color: white;
    }

    table tr:nth-child(even) {
      background: #f9f9f9;
    }

    .attendance-options {
      display: flex;
      justify-content: center;
      gap: 12px;
    }

    .attendance-options label {
      padding: 8px 16px;
      border-radius: 6px;
      border: 1px solid #ccc;
      cursor: pointer;
      transition: all 0.3s;
      font-size: 14px;
      user-select: none;
    }

    .attendance-options input[type="radio"] {
      display: none;
    }

    .attendance-options input[type="radio"]:checked + label {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      border-color: #667eea;
    }

    .btn-submit {
      display: block;
      margin: 0 auto;
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      padding: 12px 25px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 16px;
      transition: all 0.3s ease-in-out;
    }

    .btn-submit:hover {
      opacity: 0.9;
      transform: scale(1.05);
    }

    @media (max-width: 768px) {
      .attendance-options {
        flex-direction: column;
        gap: 6px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Mark Employee Attendance</h1>
    <form action="/attendance" method="POST">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Designation</th>
            <th>Attendance</th>
          </tr>
        </thead>
        <tbody>
          <% result.forEach(employee => { %>
          <tr>
            <td><%= employee.id %></td>
            <td><%= employee.name %></td>
            <td><%= employee.designation %></td>
            <td>
              <div class="attendance-options">
  <input 
    type="radio" 
    id="present-<%= employee.id %>" 
    name="attendance[emp_<%= employee.id %>]" 
    value="Present" 
    required
  />
  <label for="present-<%= employee.id %>">Present</label>

  <input 
    type="radio" 
    id="absent-<%= employee.id %>" 
    name="attendance[emp_<%= employee.id %>]" 
    value="Absent"
  />
  <label for="absent-<%= employee.id %>">Absent</label>

  <input 
    type="radio" 
    id="leave-<%= employee.id %>" 
    name="attendance[emp_<%= employee.id %>]" 
    value="On-leave"
  />
  <label for="leave-<%= employee.id %>">On Leave</label>
</div>

            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <button type="submit" class="btn-submit">Submit Attendance</button>
    </form>
  </div>
</body>
</html>
