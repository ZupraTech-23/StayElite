<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/wifiinfo.css">
    <title>wifi info</title>
</head>
<body>
    
 
  
</head>
<body>
  <h1>Wifi Info's</h1>

  <table>
    <thead>
      <tr>
        <th>Wifi</th>
        <th>Password</th>
        <th>Location</th>
        
      </tr>
    </thead>
    <tbody>
      <% for(res of result) { %>
        <tr>
          <td> <%= res.wifi_name %></td>
          <td><%= res.password %></td>
          <td><%= res.location %></td>
        </tr>

        <% } %>
    </tbody>
  </table>
  
</table>

  
</body>
</html>

</body>
</html>